APNS_PRODUCTION=false

# Firebase Cloud Messaging (FCM) - For Android
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_SENDER_ID=your_fcm_sender_id
FCM_PROJECT_ID=your_firebase_project_id
FCM_PRIVATE_KEY_ID=your_private_key_id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----"
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FCM_CLIENT_ID=your_client_id
FCM_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FCM_TOKEN_URI=https://oauth2.googleapis.com/token

# Apple Push Notification Service (APNs) - For iOS
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_BUNDLE_ID=com.yourcompany.yourapp
APNS_PRIVATE_KEY_PATH=/path/to/your/AuthKey_XXXXXXXXXX.p8
APNS_PRODUCTION=false

# Push Notification Service Selection
# Options: expo, fcm, apns, mixed
PUSH_SERVICE=expo

# Push Notification Settings
PUSH_BATCH_SIZE=100
PUSH_MAX_RETRIES=3
PUSH_RETRY_DELAY=1000
PUSH_TIMEOUT=30

# ==========================================
# NOTIFICATION SYSTEM CONFIGURATION
# ==========================================

# Notification Settings
NOTIFICATION_DEFAULT_PRIORITY=normal
NOTIFICATION_MAX_RECIPIENTS=1000
NOTIFICATION_CLEANUP_DAYS=90
NOTIFICATION_STATS_CACHE_TTL=300

# Queue Configuration for Notifications
QUEUE_NOTIFICATION_HIGH=notification-high
QUEUE_NOTIFICATION_NORMAL=notification-normal
QUEUE_NOTIFICATION_LOW=notification-low
QUEUE_BROADCAST_HIGH=broadcast-high
QUEUE_BROADCAST_NORMAL=broadcast-normal
QUEUE_PUSH_URGENT=push-urgent
QUEUE_PUSH_HIGH=push-high
QUEUE_PUSH_NORMAL=push-normal

# ==========================================
# DEVELOPMENT & TESTING
# ==========================================

# Test Push Tokens (for development)
TEST_EXPO_TOKEN=ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]
TEST_FCM_TOKEN=your_test_fcm_token_here
TEST_APNS_TOKEN=your_test_apns_token_here

# Debug Settings
NOTIFICATION_DEBUG=false
PUSH_NOTIFICATION_DEBUG=false
BROADCAST_DEBUG=false

# ==========================================
# HNB CYBERSOURCE PAYMENT GATEWAY
# ==========================================
# CYBERSOURCE_ENV: "test" (sandbox) or "production"
CYBERSOURCE_ENV=test
CYBERSOURCE_MERCHANT_ID=your_cybersource_merchant_id
CYBERSOURCE_REST_KEY_ID=your_cybersource_rest_key_id
CYBERSOURCE_SHARED_SECRET=your_cybersource_shared_secret
# Billing currency charged to the card. Confirm with HNB before switching production currency.
CYBERSOURCE_CURRENCY=USD
# Online payment service charge percentage, added on top of the invoice amount.
CYBERSOURCE_SERVICE_FEE_PERCENTAGE=3
