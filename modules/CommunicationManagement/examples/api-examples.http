### Real-Time Push Notifications API Examples
### Use these examples with VS Code REST Client extension or Postman

@baseUrl = http://localhost:8000/api
@authToken = your_auth_token_here

###
# 1. Register Push Token
POST {{baseUrl}}/user-management/push-tokens/register
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "device_id": "test-device-123",
  "push_token": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]",
  "platform": "ios",
  "app_version": "1.0.0",
  "device_name": "John's iPhone",
  "device_model": "iPhone 14 Pro",
  "os_version": "17.1.1"
}

###
# 2. Create Basic Notification
POST {{baseUrl}}/communication-management/notifications/create
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "notification_type_id": 1,
  "title": "Welcome Message",
  "message": "Welcome to our school app! We're excited to have you.",
  "priority": "normal",
  "target_type": "user",
  "target_data": {
    "user_ids": [1]
  }
}

###
# 3. Create Urgent Broadcast Notification
POST {{baseUrl}}/communication-management/notifications/create
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "notification_type_id": 2,
  "title": "Emergency Alert",
  "message": "School lockdown in effect. Please follow safety protocols.",
  "priority": "urgent",
  "target_type": "broadcast",
  "target_data": {},
  "action_url": "/emergency/lockdown",
  "action_text": "View Instructions",
  "metadata": {
    "emergency_type": "lockdown",
    "severity": "high",
    "requires_response": true
  }
}

###
# 4. Create Class-Specific Notification
POST {{baseUrl}}/communication-management/notifications/create
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "notification_type_id": 3,
  "title": "Assignment Reminder",
  "message": "Don't forget: Science project is due tomorrow!",
  "priority": "high",
  "target_type": "class",
  "target_data": {
    "grade_level_class_ids": [1, 2, 3]
  },
  "action_url": "/assignments/science-project",
  "action_text": "Submit Assignment",
  "expires_at": "2024-01-15T23:59:59Z"
}

###
# 5. Create Scheduled Notification
POST {{baseUrl}}/communication-management/notifications/create
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "notification_type_id": 4,
  "title": "Exam Tomorrow",
  "message": "Your mathematics exam is scheduled for tomorrow at 9 AM. Good luck!",
  "priority": "high",
  "target_type": "user",
  "target_data": {
    "user_ids": [5, 6, 7]
  },
  "is_scheduled": true,
  "scheduled_at": "2024-01-14T18:00:00Z",
  "action_url": "/exams/math-final",
  "action_text": "View Exam Details"
}

###
# 6. Get User Notifications (Paginated)
POST {{baseUrl}}/communication-management/notifications/list
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "page": 1,
  "per_page": 20,
  "filter": "unread",
  "priority": "high"
}

###
# 7. Mark Notification as Read
POST {{baseUrl}}/communication-management/notifications/mark-read
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "notification_id": 123
}

###
# 8. Mark All Notifications as Read
POST {{baseUrl}}/communication-management/notifications/mark-read
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "mark_all": true
}

###
# 9. Get Notification Details
POST {{baseUrl}}/communication-management/notifications/details
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "notification_id": 123
}

###
# 10. Get Notification Statistics
POST {{baseUrl}}/communication-management/notifications/stats
Authorization: Bearer {{authToken}}
Content-Type: application/json

{}

###
# 11. Delete Notification
POST {{baseUrl}}/communication-management/notifications/delete
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "notification_id": 123
}

###
# 12. Delete Push Token
POST {{baseUrl}}/user-management/push-tokens/delete
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "device_id": "test-device-123"
}

###
# 13. Create Announcement with Notification
POST {{baseUrl}}/communication-management/announcements/create
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "School Holiday Announcement",
  "content": "We are pleased to announce a special holiday on Friday for the annual school celebration.",
  "category_id": 1,
  "priority_level": 2,
  "status": "published",
  "target_type": "broadcast",
  "is_featured": true,
  "save_announcement": true
}

###
