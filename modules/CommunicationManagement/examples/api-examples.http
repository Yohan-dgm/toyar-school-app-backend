###
# 15. Bulk Test - Create Multiple Notifications
POST {{baseUrl}}/communication-management/notifications/create
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "notification_type_id": 1,
  "title": "Bulk Test Notification {{$timestamp}}",
  "message": "This is a test notification for load testing purposes.",
  "priority": "normal",
  "target_type": "broadcast",
  "target_data": {},
  "metadata": {
    "test_type": "bulk_load",
    "batch_id": "{{$guid}}",
    "timestamp": "{{$timestamp}}"
  }
}

###
